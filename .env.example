# ============================================================================
#  LinkedIn Profile API — configuration template
#  Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# ============================================================================

# ---------------------------------------------------------------- REQUIRED --
# LinkedIn session cookie. Get it from a browser logged into LinkedIn:
#   DevTools > Application > Cookies > https://www.linkedin.com > li_at
# Use a THROWAWAY account. This traffic can get an account restricted.
LINKEDIN_LI_AT=

# LEAVE THIS EMPTY. The JSESSIONID cookie doubles as LinkedIn's CSRF token and
# must belong to the same login session as li_at. A mismatched pair causes
# "403 CSRF check failed", and LinkedIn responds to repeated CSRF failures by
# REVOKING the session — logging you out of your own browser.
# The service loads a page on startup to negotiate its own matching value, so
# li_at alone is not just sufficient, it is safer. Only set this if you copied
# both values from the same browser window at the same moment.
LINKEDIN_JSESSIONID=

# Keys that clients must send as `X-API-Key`. Comma-separated for multiple.
# Only consulted when REQUIRE_API_KEY=true (see below).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# ---------------------------------------------------------------- OPTIONAL --

# Multiple accounts, rotated automatically. Overrides LINKEDIN_LI_AT when set.
# LINKEDIN_ACCOUNTS_JSON=[{"li_at":"...","jsessionid":"ajax:...","label":"acct-1"}]

# Programmatic login fallback. Usually blocked by a CAPTCHA/2FA checkpoint from
# a datacenter IP, so cookies remain the supported path.
# LINKEDIN_EMAIL=
# LINKEDIN_PASSWORD=
# ENABLE_PASSWORD_LOGIN=false

# Set true to require `X-API-Key` on the profile endpoints. Any deployment
# holding a real LinkedIn cookie should, since an open endpoint is an open
# proxy onto that account. Off here so a fresh clone runs without setup.
REQUIRE_API_KEY=false

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# Acquisition tiers. Turn one off to exercise the fallback chain.
ENABLE_GRAPHQL_TIER=true
ENABLE_REST_TIER=true
ENABLE_HTML_TIER=true

# Upstream pacing. Defaults are deliberately gentle — raising them is the
# fastest way to get a LinkedIn account rate-limited or restricted.
MAX_CONCURRENT_UPSTREAM=4
REQUESTS_PER_MINUTE_PER_SESSION=30
MIN_DELAY_BETWEEN_REQUESTS_MS=350
JITTER_MS=400
SESSION_COOLDOWN_SECONDS=900
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3

# Cache. Redis is shared across instances; without it an in-process cache is used.
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=512

# GraphQL queryId resolution.
QUERY_ID_FILE=query_ids.json
ENABLE_QUERY_ID_DISCOVERY=true
QUERY_ID_DISCOVERY_TTL_SECONDS=21600
